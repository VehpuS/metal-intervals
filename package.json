{
  "name": "metal-intervals",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "PLAYWRIGHT_HTML_OUTPUT_DIR=test-results/playwright-report PLAYWRIGHT_JSON_OUTPUT_FILE=test-results/playwright-results.json PLAYWRIGHT_BLOB_OUTPUT_DIR=test-results/blob-report playwright test",
    "test:e2e:sweep": "PLAYWRIGHT_HTML_OPEN=never npm run test:e2e -- --reporter=dot,html,json"
  },
  "dependencies": {
    "lucide-react": "^0.511.0",
    "papaparse": "^5.5.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.1.8",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^4.1.6",
    "jsdom": "^29.1.1",
    "typescript": "~5.8.3",
    "vite": "^7.0.0",
    "vitest": "^4.1.11"
  }
}
